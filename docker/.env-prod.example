# AuraData BI production settings for docker-compose-prod.yml.
# Copy to docker/.env-prod (git-ignored) and replace every "change-me" value.

# Long random string; generate one with: openssl rand -base64 42
# Never change it once there is data: it encrypts the database passwords.
SUPERSET_SECRET_KEY=change-me

# Metadata database (the bundled PostgreSQL container)
POSTGRES_DB=mibi
POSTGRES_USER=mibi
POSTGRES_PASSWORD=change-me

# First admin user, created on the first start
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Public address of AuraData BI, used in the links of report emails
MIBI_PUBLIC_URL=https://bi.example.com/

# true when AuraData BI is served over HTTPS (it should be). Set to false only to try
# the stack over plain http://localhost:8088, or login will not work.
MIBI_HTTPS=true

# Alerts and scheduled reports: false logs them instead of sending them
MIBI_SEND_REPORTS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=mibi@example.com

# MCP service (docker compose --profile mcp). AI agents send a JWT signed with
# this secret (HS256) whose "sub" claim is the username they act as. Leave empty
# to refuse every MCP request.
MCP_JWT_SECRET=

SUPERSET_LOG_LEVEL=info
